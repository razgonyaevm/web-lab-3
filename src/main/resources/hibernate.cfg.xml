<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Database connection -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/studs</property>
        <property name="hibernate.connection.username">${db.username}</property>
        <property name="hibernate.connection.password">${db.password}</property>

        <!-- SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Show SQL -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Auto create tables -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Connection pool -->
        <property name="hibernate.connection.pool_size">5</property>

        <!-- Jakarta EE 10 compatibility -->
        <property name="hibernate.jakarta.persistence">true</property>

        <!-- Mapping class -->
        <mapping class="com.areaapp.entity.PointResult"/>
    </session-factory>
</hibernate-configuration>